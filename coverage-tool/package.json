{
  "name": "gad-coverage-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic API coverage tool for the GAD OpenAPI spec",
  "main": "src/analyze.js",
  "bin": { "gad-coverage": "bin/coverage.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "report": "node bin/coverage.js report",
    "diff": "node bin/coverage.js diff",
    "test": "node --test test/*.test.js",
    "update-golden": "node test/update-golden.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0"
  }
}
